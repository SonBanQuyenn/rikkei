{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAnalyticsBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::shopfast-analytics"
    },
    {
      "Sid": "ReadAnalyticsObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::shopfast-analytics/*"
    }
  ]
}
