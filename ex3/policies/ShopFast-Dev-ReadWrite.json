{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DevBucketsAndObjects",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::shopfast-dev-*",
        "arn:aws:s3:::shopfast-dev-*/*"
      ]
    },
    {
      "Sid": "DevNamedServiceResources",
      "Effect": "Allow",
      "Action": ["lambda:*", "sqs:*", "logs:*", "dynamodb:*"],
      "Resource": [
        "arn:aws:lambda:*:123456789012:function:shopfast-dev-*",
        "arn:aws:sqs:*:123456789012:shopfast-dev-*",
        "arn:aws:logs:*:123456789012:log-group:/shopfast/dev/*",
        "arn:aws:dynamodb:*:123456789012:table/shopfast-dev-*"
      ]
    },
    {
      "Sid": "PassOnlyDevAppRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::123456789012:role/shopfast-dev-app-*",
      "Condition": {
        "StringEquals": { "iam:PassedToService": ["lambda.amazonaws.com", "ec2.amazonaws.com"] }
      }
    },
    {
      "Sid": "Ec2ManageDevInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:*:123456789012:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Environment": "dev" } }
    },
    {
      "Sid": "Ec2LaunchOnlyTaggedDev",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:123456789012:instance/*",
      "Condition": { "StringEquals": { "aws:RequestTag/Environment": "dev" } }
    },
    {
      "Sid": "Ec2LaunchSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*:123456789012:subnet/*",
        "arn:aws:ec2:*:123456789012:network-interface/*",
        "arn:aws:ec2:*:123456789012:security-group/*",
        "arn:aws:ec2:*:123456789012:volume/*",
        "arn:aws:ec2:*:123456789012:key-pair/*"
      ]
    },
    {
      "Sid": "Ec2TagOnlyAtLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:*:123456789012:*/*",
      "Condition": { "StringEquals": { "ec2:CreateAction": "RunInstances" } }
    }
  ]
}
