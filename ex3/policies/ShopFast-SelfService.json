{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ViewAccountPasswordRules",
      "Effect": "Allow",
      "Action": ["iam:GetAccountPasswordPolicy", "iam:ListVirtualMFADevices"],
      "Resource": "*"
    },
    {
      "Sid": "ManageOwnPasswordAndProfile",
      "Effect": "Allow",
      "Action": ["iam:ChangePassword", "iam:GetUser", "iam:GetLoginProfile"],
      "Resource": "arn:aws:iam::123456789012:user/${aws:username}"
    },
    {
      "Sid": "ManageOwnMfaDevice",
      "Effect": "Allow",
      "Action": ["iam:CreateVirtualMFADevice", "iam:DeleteVirtualMFADevice"],
      "Resource": "arn:aws:iam::123456789012:mfa/${aws:username}"
    },
    {
      "Sid": "EnableOwnMfa",
      "Effect": "Allow",
      "Action": ["iam:EnableMFADevice", "iam:ListMFADevices", "iam:ResyncMFADevice"],
      "Resource": "arn:aws:iam::123456789012:user/${aws:username}"
    },
    {
      "Sid": "DeactivateOwnMfaOnlyWithMfa",
      "Effect": "Allow",
      "Action": "iam:DeactivateMFADevice",
      "Resource": "arn:aws:iam::123456789012:user/${aws:username}",
      "Condition": { "Bool": { "aws:MultiFactorAuthPresent": "true" } }
    },
    {
      "Sid": "ManageOwnAccessKeys",
      "Effect": "Allow",
      "Action": ["iam:CreateAccessKey", "iam:ListAccessKeys", "iam:UpdateAccessKey", "iam:DeleteAccessKey"],
      "Resource": "arn:aws:iam::123456789012:user/${aws:username}"
    }
  ]
}
