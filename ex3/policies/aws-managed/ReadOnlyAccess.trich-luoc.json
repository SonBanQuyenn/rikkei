{
  "_ghi_chu": "Trích lược chính sách AWS quản lý arn:aws:iam::aws:policy/ReadOnlyAccess (bản gốc liệt kê Get*/List*/Describe* cho hơn 300 dịch vụ) - chỉ giữ các dịch vụ dùng trong mô phỏng.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:Get*",
        "s3:Get*",
        "s3:List*",
        "lambda:Get*",
        "lambda:List*",
        "logs:Describe*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "rds:Describe*",
        "rds:List*",
        "sqs:Get*",
        "sqs:List*",
        "dynamodb:Describe*",
        "dynamodb:List*",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "cloudtrail:Describe*",
        "cloudtrail:Get*",
        "cloudtrail:LookupEvents",
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": "*"
    }
  ]
}
