{
  "_ghi_chu": "Bản sao nội dung chính sách AWS quản lý arn:aws:iam::aws:policy/PowerUserAccess - chỉ dùng cho bộ mô phỏng; khi triển khai thật gắn trực tiếp ARN của AWS.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "NotAction": ["iam:*", "organizations:*", "account:*"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "account:GetAccountInformation",
        "account:GetPrimaryEmail",
        "account:ListRegions",
        "iam:CreateServiceLinkedRole",
        "iam:DeleteServiceLinkedRole",
        "iam:ListRoles",
        "organizations:DescribeOrganization"
      ],
      "Resource": "*"
    }
  ]
}
