{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OpsEngineersWithFreshMfaOnly",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::123456789012:root" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": { "aws:MultiFactorAuthPresent": "true" },
        "NumericLessThan": { "aws:MultiFactorAuthAge": "3600" },
        "StringEquals": { "aws:PrincipalTag/Team": "ops" },
        "ArnLike": { "aws:PrincipalArn": "arn:aws:iam::123456789012:user/*" }
      }
    },
    {
      "Sid": "SessionMustCarryRealUserName",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::123456789012:root" },
      "Action": "sts:SetSourceIdentity",
      "Condition": {
        "StringEquals": { "sts:SourceIdentity": "${aws:username}" }
      }
    }
  ]
}
