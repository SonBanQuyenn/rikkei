{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteInvoicePdfOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::shopfast-prod-invoices/invoices/*"
    },
    {
      "Sid": "ReadOnlyTheAppDbSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:shopfast/prod/db-app-??????"
    },
    {
      "Sid": "UseKmsKeyOnlyThroughS3AndSecretsManager",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "arn:aws:kms:ap-southeast-1:123456789012:key/1111aaaa-22bb-33cc-44dd-555555eeeeee",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "s3.ap-southeast-1.amazonaws.com",
            "secretsmanager.ap-southeast-1.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "StolenEc2CredentialsAreUselessOutsideOurVpc",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": { "aws:EC2InstanceSourceVPC": "vpc-0a1b2c3d4e5f60718" },
        "Null": { "aws:EC2InstanceSourceVPC": "false" },
        "BoolIfExists": { "aws:ViaAWSService": "false" }
      }
    }
  ]
}
