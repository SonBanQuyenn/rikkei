{
    "info": {
        "name": "Books API",
        "description": "API quản lý sách với header versioning và deprecation",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "GET Books - Version 1",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Api-Version",
                        "value": "v1"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/books",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "books"
                    ]
                }
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code là 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Response đúng cấu trúc v1\", function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('success', true);",
                            "    pm.expect(jsonData).to.have.property('version', 'v1');",
                            "    pm.expect(jsonData.data).to.be.an('array');",
                            "    ",
                            "    if (jsonData.data.length > 0) {",
                            "        const book = jsonData.data[0];",
                            "        pm.expect(book).to.have.all.keys('id', 'title', 'author');",
                            "        pm.expect(book.author).to.be.a('string');",
                            "    }",
                            "});",
                            "",
                            "pm.test(\"Response có Deprecation header\", function () {",
                            "    pm.response.to.have.header('Deprecation');",
                            "    pm.expect(pm.response.headers.get('Deprecation')).to.equal('true');",
                            "});",
                            "",
                            "pm.test(\"Response có Sunset header\", function () {",
                            "    pm.response.to.have.header('Sunset');",
                            "    const sunset = pm.response.headers.get('Sunset');",
                            "    pm.expect(sunset).to.include('2025');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
