{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyEcsTasksOfThisAccount",
      "Effect": "Allow",
      "Principal": { "Service": "ecs-tasks.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "222222222222" },
        "ArnLike": { "aws:SourceArn": "arn:aws:ecs:ap-southeast-1:222222222222:*" }
      }
    }
  ]
}
