{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyBackupWriterMayWrite",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::shopfast-prod-backup/*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::222222222222:role/shopfast-prod-db-backup-writer"
        }
      }
    },
    {
      "Sid": "NobodyDeletesBackups",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket",
        "s3:PutLifecycleConfiguration",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": [
        "arn:aws:s3:::shopfast-prod-backup",
        "arn:aws:s3:::shopfast-prod-backup/*"
      ]
    },
    {
      "Sid": "TlsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::shopfast-prod-backup",
        "arn:aws:s3:::shopfast-prod-backup/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
